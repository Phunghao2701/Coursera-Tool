# ============================================================
# Git Ignore for Coursera Bot
# ============================================================

# Environment variables & sensitive credentials (KHÔNG ĐƯỢC COMMIT)
.env
.env.local
.env.*.local
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and Editor settings
.vscode/
.idea/
*.swp
*.swo

# Project logs & temporary files
*.log
logs/
data/
py_cmd.txt
