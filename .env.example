# ============================================================
#  COURSERA BOT - BIẾN MÔI TRƯỜNG MẪU (.env.example)
#  Sao chép file này thành .env và điền thông tin thực tế của bạn
# ============================================================

# --- Tài khoản Coursera ---
COURSERA_EMAIL=your_email@example.com
COURSERA_PASSWORD=your_password_here

# --- Khóa học cần chạy ---
COURSE_URL=https://www.coursera.org/learn/your-course-slug/home/welcome

# --- Cài đặt bot ---
# HEADLESS: true = chạy ngầm không hiện trình duyệt, false = hiện cửa sổ Chrome
HEADLESS=false

# VIDEO_SPEED: Tốc độ phát video (1.0 = bình thường, 1.5, 2.0 = x2 tốc độ)
VIDEO_SPEED=2.0

# READING_WAIT: Số giây dừng lại để đọc tài liệu (Coursera yêu cầu tối thiểu ~30s để tích điểm)
READING_WAIT=35

# RETRY_LIMIT: Số lần thử lại tối đa cho mỗi bài nếu chưa nhận được tích xanh
RETRY_LIMIT=3

# DISCUSSION_TEXT: Nội dung tự động bình luận tại các mục Discussion Prompt
DISCUSSION_TEXT=ok

# --- Timeout chung (tính theo giây) ---
PAGE_LOAD_TIMEOUT=30
ELEMENT_TIMEOUT=15

# --- Cấu hình Web Dashboard (VPS) ---
DASHBOARD_PASSWORD=your_secret_password_here
DASHBOARD_PORT=3987
